root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.json]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.lua]
indent_size = 2

[*.toml]
indent_size = 2

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[{configure,configure.*,config.*,*.{sh,yml,yaml}}]
indent_size = 2
indent_style = space

[{dot_gitconfig,git/**}]
indent_size = 4

[{makefile.vc,nmake.opt}]
end_of_line = crlf
indent_style = tab
indent_size = tab
tab_width = 4

[Makefile]
indent_style = tab
indent_size = tab
tab_width = 4

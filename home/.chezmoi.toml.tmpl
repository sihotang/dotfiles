# Local chezmoi config defaults. Keep secrets out of this file.
[data]
  machine = "{{ .chezmoi.hostname }}"
  os = "{{ .chezmoi.os }}"
  ollamaHost = {{ (index . "ollamaHost" | default "127.0.0.1:11434") | toToml }}
  workspaceDir = {{ (index . "workspaceDir" | default "Workspace") | toToml }}
  profilesDir = {{ (index . "profilesDir" | default ".config/profiles") | toToml }}
  defaultProfile = {{ (index . "defaultProfile" | default "Default") | toToml }}

#!/usr/bin/env zsh

# Load shared environment settings for interactive non-login shells.
if [[ -z ${_DOT_ENV_LOADED:-} ]]; then
  [[ -f "$HOME/.config/zsh/exports.zsh" ]] && source "$HOME/.config/zsh/exports.zsh"
  typeset -g _DOT_ENV_LOADED=1
fi

# Load Oh My Zsh when it is installed.
omz_dir="${ZSH:-$HOME/.oh-my-zsh}"
[[ -r "$omz_dir/oh-my-zsh.sh" ]] && source "$omz_dir/oh-my-zsh.sh"

# Load modular Zsh configuration.
for file in "$HOME/.config/zsh"/*.zsh(N); do
  [[ "$file" == "$HOME/.config/zsh/exports.zsh" ]] && continue
  source "$file"
done

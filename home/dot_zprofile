#!/usr/bin/env zsh

# Load shared environment settings for login shells.
[[ -f "$HOME/.exports" ]] && source "$HOME/.exports"

# Initialize Homebrew for Apple Silicon or Intel Macs when installed.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Initialize OrbStack's shell integration when installed.
[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :


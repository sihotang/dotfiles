{{ if and (eq .chezmoi.os "darwin") (lookPath "brew") -}}
#!/bin/sh

set -eu

if brew list --formula --versions mise >/dev/null 2>&1; then
  brew uninstall mise
fi

if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL '{{ .packages.common.mise.installer }}' | sh
fi

if ! brew list --cask --versions visual-studio-code >/dev/null 2>&1; then
  brew install --cask --adopt visual-studio-code
fi

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.homebrew.formula }}brew "{{ . }}"
{{ end -}}
{{ range .packages.darwin.homebrew.cask }}cask "{{ . }}"
{{ end -}}
EOF

brew cleanup --prune=all
{{ end -}}

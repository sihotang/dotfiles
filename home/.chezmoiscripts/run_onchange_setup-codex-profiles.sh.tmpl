{{- if .codexAccounts -}}
#!/bin/sh
# Sets up Codex account profile directories for: {{ .codexAccounts | join ", " }}
set -eu

profiles_base="{{ .chezmoi.homeDir }}/{{ .codexProfilesDir }}"
agents_src="{{ .chezmoi.homeDir }}/.codex/AGENTS.md"

{{ range .codexAccounts -}}
profile_dir="$profiles_base/{{ . }}"
mkdir -p "$profile_dir"

# Symlink AGENTS.md to the main profile unless already overridden.
if [ ! -e "$profile_dir/AGENTS.md" ]; then
  ln -sf "$agents_src" "$profile_dir/AGENTS.md"
fi

# Create a default config.toml stub if none exists yet.
if [ ! -f "$profile_dir/config.toml" ]; then
  printf '# Codex profile: %s\n# Customize model, approval_policy, sandbox_mode, and other settings here.\n# See: https://github.com/openai/codex#configuration\n' '{{ . }}' > "$profile_dir/config.toml"
fi

{{ end -}}
{{- end -}}

#!/bin/sh
{{ $profilesDir := (index . "profilesDir") | default ".config/profiles" -}}
{{- $profiles := (index . "profiles") | default dict -}}
{{- $globalProfileInstructions := index $profiles "instructions" | default "" -}}
{{- if and $globalProfileInstructions (not (kindIs "string" $globalProfileInstructions)) -}}
  {{- fail "profiles.instructions must be a string" -}}
{{- end -}}
{{- $globalProfileAdditionalInstructions := index $profiles "additionalInstructions" | default "" -}}
{{- if and $globalProfileAdditionalInstructions (not (kindIs "string" $globalProfileAdditionalInstructions)) -}}
  {{- fail "profiles.additionalInstructions must be a string" -}}
{{- end -}}
{{- range $profile, $config := $profiles -}}
  {{- if not (or (eq $profile "instructions") (eq $profile "additionalInstructions")) -}}
    {{- if not (regexMatch "^[a-zA-Z0-9._-]+$" $profile) -}}
      {{- fail (printf "invalid profile name %q" $profile) -}}
    {{- end -}}
    {{- $tools := $config -}}
    {{- if not (kindIs "slice" $config) -}}
      {{- $tools = index $config "tools" -}}
      {{- $profileInstructions := index $config "instructions" -}}
      {{- if and $profileInstructions (not (kindIs "string" $profileInstructions)) -}}
        {{- fail (printf "profile %q field %q must be a string" $profile "instructions") -}}
      {{- end -}}
      {{- $profileAdditionalInstructions := index $config "additionalInstructions" -}}
      {{- if and $profileAdditionalInstructions (not (kindIs "string" $profileAdditionalInstructions)) -}}
        {{- fail (printf "profile %q field %q must be a string" $profile "additionalInstructions") -}}
      {{- end -}}
      {{- range $tool := list "codex" "claude" "copilot" "gemini" -}}
        {{- $toolConfig := index $config $tool -}}
        {{- if $toolConfig -}}
          {{- if not (kindIs "map" $toolConfig) -}}
            {{- fail (printf "profile %q tool instructions for %q must be a table" $profile $tool) -}}
          {{- end -}}
          {{- range $field := list "instructions" "additionalInstructions" -}}
            {{- $value := index $toolConfig $field -}}
            {{- if and $value (not (kindIs "string" $value)) -}}
              {{- fail (printf "profile %q tool %q field %q must be a string" $profile $tool $field) -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- range $tool := $tools -}}
      {{- if not (or (eq $tool "codex") (eq $tool "claude") (eq $tool "copilot") (eq $tool "gemini") (eq $tool "gh") (eq $tool "git") (eq $tool "vscode") (eq $tool "antigravity")) -}}
        {{- fail (printf "unsupported profile tool %q in profile %q" $tool $profile) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- printf "\n" -}}
# Initializes state directories for configured CLI and app profiles.
set -eu
umask 077

profiles_base="$HOME/{{ $profilesDir }}"

# Delete profile directories that are no longer declared in profiles.toml.
remove_unconfigured_profiles() {
  [ -d "$profiles_base" ] || return 0
  for profile_dir in "$profiles_base"/* "$profiles_base"/.[!.]* "$profiles_base"/..?*; do
    [ -d "$profile_dir" ] || continue
    profile_name=${profile_dir##*/}
    case "$profile_name" in{{ printf "\n" -}}
{{- range $profile, $config := $profiles -}}
  {{- if not (or (eq $profile "instructions") (eq $profile "additionalInstructions")) -}}
    {{- $tools := $config -}}
    {{- if not (kindIs "slice" $config) -}}
      {{- $tools = index $config "tools" -}}
    {{- end -}}
    {{- if $tools -}}
      {{ printf "      '%s') ;;\n" $profile }}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ printf "      *) rm -rf -- \"$profile_dir\" ;;\n" }}
    esac
  done
}

remove_unconfigured_profiles

# Create a profile's state directory for the selected tool.
create_profile() {
  tool="$1"
  name="$2"
  profile_dir="$profiles_base/$name/$tool"
  mkdir -p "$profile_dir"
}

# Link a shared configuration file into a profile without replacing user data.
link_if_missing() {
  source_file="$1"
  target_file="$2"
  if [ -f "$source_file" ] && [ ! -e "$target_file" ]; then
    mkdir -p "$(dirname "$target_file")"
    ln -s "$source_file" "$target_file"
  fi
}

profile_instruction_marker='<!-- Managed by chezmoi; edit profiles.toml instead. -->'

# Restore a profile instruction file to the shared source when it is still managed.
restore_shared_instructions() {
  source_file="$1"
  target_file="$2"
  if [ -f "$target_file" ] && [ "$(sed -n '1p' "$target_file")" = "$profile_instruction_marker" ]; then
    rm -f -- "$target_file"
  fi
  link_if_missing "$source_file" "$target_file"
}

# Write profile instructions while preserving custom files and links.
# Arguments: source, destination, mode, profile text, profile addendum, tool text, tool addendum.
write_profile_instructions() {
  instruction_source="$1"
  instruction_target="$2"
  instruction_mode="$3"
  profile_instructions="$4"
  profile_additional_instructions="$5"
  tool_instructions="$6"
  tool_additional_instructions="$7"

  if [ "$instruction_mode" = shared ] && [ -z "$profile_additional_instructions" ] && [ -z "$tool_additional_instructions" ]; then
    restore_shared_instructions "$instruction_source" "$instruction_target"
    return 0
  fi

  if [ -L "$instruction_target" ]; then
    existing_target=$(readlink "$instruction_target")
    if [ "$existing_target" != "$instruction_source" ]; then
      printf 'Preserving custom profile instruction link: %s\n' "$instruction_target" >&2
      return 0
    fi
  elif [ -e "$instruction_target" ] && [ "$(sed -n '1p' "$instruction_target")" != "$profile_instruction_marker" ]; then
    printf 'Preserving custom profile instruction file: %s\n' "$instruction_target" >&2
    return 0
  fi

  mkdir -p "$(dirname "$instruction_target")"
  instruction_temp="${instruction_target}.tmp.$$"
  {
    printf '%s\n' "$profile_instruction_marker"
    case "$instruction_mode" in
      tool)
        printf '%s\n' "$tool_instructions"
        ;;
      profile)
        printf '%s\n' "$profile_instructions"
        ;;
      shared)
        [ ! -f "$instruction_source" ] || cat "$instruction_source"
        ;;
    esac
    if [ "$instruction_mode" != tool ] && [ -n "$profile_additional_instructions" ]; then
      printf '\n%s\n' "$profile_additional_instructions"
    fi
    if [ -n "$tool_additional_instructions" ]; then
      printf '\n%s\n' "$tool_additional_instructions"
    fi
  } > "$instruction_temp"
  mv -f "$instruction_temp" "$instruction_target"
}

# Select the instruction mode and write shared, profile, and tool instructions.
write_tool_profile_instructions() {
  instruction_source="$1"
  instruction_target="$2"
  tool_instructions="$3"
  tool_additional_instructions="$4"
  instruction_mode=shared

  [ -z "$profile_instructions" ] || instruction_mode=profile
  [ -z "$tool_instructions" ] || instruction_mode=tool

  write_profile_instructions \
    "$instruction_source" \
    "$instruction_target" \
    "$instruction_mode" \
    "$profile_instructions" \
    "$profile_additional_instructions" \
    "$tool_instructions" \
    "$tool_additional_instructions"
}

{{ range $profile, $config := $profiles -}}
{{ if not (or (eq $profile "instructions") (eq $profile "additionalInstructions")) -}}
{{ $tools := $config }}
{{ if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{ $profileInstructions := $globalProfileInstructions -}}
{{ $profileAdditionalInstructions := $globalProfileAdditionalInstructions -}}
{{ if kindIs "map" $config -}}
{{ $profileInstructions = index $config "instructions" | default $globalProfileInstructions -}}
{{ $profileAdditionalConfig := index $config "additionalInstructions" | default "" -}}
{{ if $profileAdditionalConfig -}}
{{ if $profileAdditionalInstructions -}}
{{ $profileAdditionalInstructions = printf "%s\n\n%s" $profileAdditionalInstructions $profileAdditionalConfig -}}
{{ else -}}
{{ $profileAdditionalInstructions = $profileAdditionalConfig -}}
{{ end -}}
{{ end -}}
{{ end -}}
{{ range $tool := $tools -}}
{{ if eq $tool "codex" -}}
create_profile codex '{{ $profile }}'
profile_dir="$profiles_base/{{ $profile }}/codex"
{{ $toolConfig := dict -}}
{{ if kindIs "map" $config -}}{{ $toolConfig = index $config "codex" | default dict }}{{ end -}}
{{ $toolInstructions := index $toolConfig "instructions" | default "" -}}
{{ $toolAdditionalInstructions := index $toolConfig "additionalInstructions" | default "" -}}
profile_instructions='{{ replace "'" "'\"'\"'" $profileInstructions }}'
profile_additional_instructions='{{ replace "'" "'\"'\"'" $profileAdditionalInstructions }}'
write_tool_profile_instructions "$HOME/.codex/AGENTS.md" "$profile_dir/AGENTS.md" '{{ replace "'" "'\"'\"'" $toolInstructions }}' '{{ replace "'" "'\"'\"'" $toolAdditionalInstructions }}'
if [ ! -f "$profile_dir/config.toml" ]; then
  printf '# Codex profile: %s\n# Store authentication in this profile for account isolation.\ncli_auth_credentials_store = "file"\n' '{{ $profile }}' > "$profile_dir/config.toml"
elif ! grep -Eq '^[[:space:]]*cli_auth_credentials_store[[:space:]]*=' "$profile_dir/config.toml"; then
  printf '\ncli_auth_credentials_store = "file"\n' >> "$profile_dir/config.toml"
fi
{{ else if eq $tool "claude" -}}
create_profile claude '{{ $profile }}'
profile_dir="$profiles_base/{{ $profile }}/claude"
{{ $toolConfig := dict -}}
{{ if kindIs "map" $config -}}{{ $toolConfig = index $config "claude" | default dict }}{{ end -}}
{{ $toolInstructions := index $toolConfig "instructions" | default "" -}}
{{ $toolAdditionalInstructions := index $toolConfig "additionalInstructions" | default "" -}}
profile_instructions='{{ replace "'" "'\"'\"'" $profileInstructions }}'
profile_additional_instructions='{{ replace "'" "'\"'\"'" $profileAdditionalInstructions }}'
write_tool_profile_instructions "$HOME/.claude/CLAUDE.md" "$profile_dir/CLAUDE.md" '{{ replace "'" "'\"'\"'" $toolInstructions }}' '{{ replace "'" "'\"'\"'" $toolAdditionalInstructions }}'
{{ else if eq $tool "copilot" -}}
create_profile copilot '{{ $profile }}'
profile_dir="$profiles_base/{{ $profile }}/copilot"
{{ $toolConfig := dict -}}
{{ if kindIs "map" $config -}}{{ $toolConfig = index $config "copilot" | default dict }}{{ end -}}
{{ $toolInstructions := index $toolConfig "instructions" | default "" -}}
{{ $toolAdditionalInstructions := index $toolConfig "additionalInstructions" | default "" -}}
profile_instructions='{{ replace "'" "'\"'\"'" $profileInstructions }}'
profile_additional_instructions='{{ replace "'" "'\"'\"'" $profileAdditionalInstructions }}'
write_tool_profile_instructions "$HOME/.copilot/copilot-instructions.md" "$profile_dir/copilot-instructions.md" '{{ replace "'" "'\"'\"'" $toolInstructions }}' '{{ replace "'" "'\"'\"'" $toolAdditionalInstructions }}'
{{ else if eq $tool "gemini" -}}
create_profile gemini '{{ $profile }}'
profile_dir="$profiles_base/{{ $profile }}/gemini/.gemini"
{{ $toolConfig := dict -}}
{{ if kindIs "map" $config -}}{{ $toolConfig = index $config "gemini" | default dict }}{{ end -}}
{{ $toolInstructions := index $toolConfig "instructions" | default "" -}}
{{ $toolAdditionalInstructions := index $toolConfig "additionalInstructions" | default "" -}}
profile_instructions='{{ replace "'" "'\"'\"'" $profileInstructions }}'
profile_additional_instructions='{{ replace "'" "'\"'\"'" $profileAdditionalInstructions }}'
write_tool_profile_instructions "$HOME/.gemini/GEMINI.md" "$profile_dir/GEMINI.md" '{{ replace "'" "'\"'\"'" $toolInstructions }}' '{{ replace "'" "'\"'\"'" $toolAdditionalInstructions }}'
link_if_missing "$HOME/.gemini/settings.json" "$profile_dir/settings.json"
{{ else if eq $tool "gh" -}}
create_profile gh '{{ $profile }}'
link_if_missing "$HOME/.config/gh/config.yml" "$profiles_base/{{ $profile }}/gh/config.yml"
{{ end -}}
{{ end -}}
{{ end -}}
{{ end -}}

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
# mise config checksum: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# mise package list checksum: {{ .packages.common.mise | toJson | sha256sum }}
set -eu

if command -v mise >/dev/null 2>&1; then
  mise install bun
  mise exec bun -- mise install
elif [ -x "$HOME/.local/bin/mise" ]; then
  "$HOME/.local/bin/mise" install bun
  "$HOME/.local/bin/mise" exec bun -- "$HOME/.local/bin/mise" install
fi
{{ end -}}

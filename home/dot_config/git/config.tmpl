[core]
    editor = {{ .editor | quote }}
    excludesfile = ~/.config/git/ignore
    attributesfile = ~/.config/git/attributes
[init]
    defaultBranch = main
{{- $profiles := (index . "profiles") | default dict }}
{{- $profilesDir := (index . "profilesDir") | default ".config/profiles" }}
{{- $hasAliases := false }}
{{- range $profile, $config := $profiles }}
  {{- $tools := $config }}
  {{- if not (kindIs "slice" $config) }}
    {{- $tools = index $config "tools" }}
  {{- end }}
  {{- if has "git" $tools }}{{ $hasAliases = true }}{{ end }}
{{- end }}
{{- if $hasAliases }}
[alias]
{{- range $profile, $config := $profiles }}
  {{- $tools := $config }}
  {{- if not (kindIs "slice" $config) }}
    {{- $tools = index $config "tools" }}
  {{- end }}
  {{- if has "git" $tools }}
    {{- $profileAlias := $profile }}
    {{- $name := "" }}
    {{- $email := "" }}
    {{- if kindIs "map" $config }}
      {{- $profileAlias = printf "%v" (index $config "alias" | default $profile) }}
      {{- $name = printf "%v" (index $config "name" | default "") }}
      {{- $email = printf "%v" (index $config "email" | default "") }}
      {{- $git := index $config "git" | default dict }}
      {{- if kindIs "map" $git }}
        {{- $name = printf "%v" (index $git "name" | default $name) }}
        {{- $email = printf "%v" (index $git "email" | default $email) }}
      {{- end }}
    {{- end }}
    {{- if not (regexMatch "^[a-zA-Z0-9._-]+$" $profileAlias) }}
      {{- fail (printf "invalid profile alias %q for profile %q" $profileAlias $profile) }}
    {{- end }}
    {{- $ghEnabled := has "gh" $tools }}
    {{- if $ghEnabled }}
      {{- $ghConfig := dict }}
      {{- if kindIs "map" $config }}
        {{- $ghConfig = index $config "gh" | default dict }}
      {{- end }}
      {{- if not (kindIs "map" $ghConfig) }}
        {{- fail (printf "gh config for profile %q must be a table" $profile) }}
      {{- end }}
    {{- end }}
    {{- $gitAlias := regexReplaceAll "[^a-zA-Z0-9-]" $profileAlias "-" }}
    {{- if not (regexMatch "^[a-zA-Z]" $gitAlias) }}
      {{- $gitAlias = printf "profile-%s" $gitAlias }}
    {{- end }}
    {{ $gitAlias }} = "!f() { {{ if $ghEnabled }}unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GIT_CONFIG_PARAMETERS; GH_CONFIG_DIR=\"$HOME/{{ $profilesDir }}/{{ $profile }}/gh\" {{ end }}git {{ if $name }}-c user.name=\"{{ $name }}\" {{ end }}{{ if $email }}-c user.email=\"{{ $email }}\" {{ end }}{{ if $ghEnabled }}-c credential.helper= -c credential.helper='!gh auth git-credential' {{ end }}\"$@\"; }; f"
  {{- end }}
{{- end }}
{{- end }}

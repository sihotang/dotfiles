# Shared global mise configuration.
# Runtime versions and global CLI tools managed by mise.
[tools]
{{ $tools := .packages.common.mise.tools -}}
{{ range $tool, $version := $tools -}}
{{ if hasPrefix "npm:" $tool -}}
{{ if kindIs "map" $version -}}
{{ printf "\"%s\" = { version = %s, bun_args = %s }\n" $tool (index $version "version" | quote) (index $version "bun_args" | quote) }}
{{- else -}}
{{ printf "\"%s\" = %s\n" $tool ($version | quote) }}
{{- end -}}
{{- else -}}
{{ printf "%s = %s\n" $tool ($version | quote) }}
{{- end -}}
{{ end }}

[settings]
# Install missing configured tools when a command needs them.
auto_install = true
# Read each tool's native version files such as .nvmrc and .python-version.
idiomatic_version_file_enable_tools = ["node", "bun", "go", "python"]
# Remove partial install directories after a failed installation.
always_keep_install = false

[settings.self_update]
auto = true

[settings.npm]
# Use Bun to install tools declared with the npm: backend.
package_manager = "bun"

#!/usr/bin/env zsh

# Navigation and file listings
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias la="ls -A"
alias ll="ls -lah"

# Git shortcuts
alias ga="git add"
alias gs="git status --short --branch"
alias gd="git diff"
alias gds="git diff --staged"
alias gb="git branch"
alias gco="git checkout"
alias gcm="git commit -m"
alias gl="git log --oneline --graph --decorate -15"
alias gpl="git pull --ff-only"
alias gp="git push"

# System shortcuts
alias dfh="df -h"

# Shell shortcuts
alias reload="source ~/.zshrc"

# Docker shortcuts
alias dps="docker ps --format 'table {{ "{{" }}.Names{{ "}}" }}\t{{ "{{" }}.Status{{ "}}" }}\t{{ "{{" }}.Ports{{ "}}" }}'"
alias dcu="docker compose up -d"
alias dcd="docker compose down"

# Path shortcuts
ws() {
  builtin cd -- "$HOME"/{{ .workspaceDir | quote }}
}
alias c="claude"
{{- if .codexAccounts }}

# Codex account switching.
# codex-use ACCOUNT [codex args...]  — run Codex under a named profile directory.
codex-use() {
  if (( $# < 1 )); then
    print -u2 'Usage: codex-use ACCOUNT [codex args...]'
    return 2
  fi
  local name="$1"
  local profile_dir="$HOME/{{ .codexProfilesDir }}/$name"
  if [[ ! -d "$profile_dir" ]]; then
    print -u2 "codex-use: profile not found: $profile_dir"
    return 1
  fi
  shift
  CODEX_HOME="$profile_dir" codex "$@"
}

# codex-pick [codex args...]  — interactive account picker (requires fzf).
codex-pick() {
  if ! command -v fzf >/dev/null 2>&1; then
    print -u2 'codex-pick: fzf not found'
    return 1
  fi
  local name
  name=$(printf '%s\n'{{ range .codexAccounts }} {{ . | quote }}{{ end }} | fzf --prompt='Codex account: ' --height=10 --no-sort) || return 1
  codex-use "$name" "$@"
}

{{ range .codexAccounts -}}
alias codex-{{ . }}='CODEX_HOME="$HOME/{{ $.codexProfilesDir }}/{{ . }}" codex'
{{ end -}}
{{- end }}

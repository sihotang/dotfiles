#!/usr/bin/env zsh

# Navigation and file listings
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias la="ls -A"
alias ll="ls -lah"

# Git shortcuts
alias ga="git add"
alias gs="git status --short --branch"
alias gd="git diff"
alias gds="git diff --staged"
alias gb="git branch"
alias gco="git checkout"
alias gcm="git commit -m"
alias gl="git log --oneline --graph --decorate -15"
alias gpl="git pull --ff-only"
alias gp="git push"

# System shortcuts
alias dfh="df -h"

# Shell shortcuts
alias reload="source ~/.zshrc"

# Docker shortcuts
alias dps="docker ps --format 'table {{ "{{" }}.Names{{ "}}" }}\t{{ "{{" }}.Status{{ "}}" }}\t{{ "{{" }}.Ports{{ "}}" }}'"
alias dcu="docker compose up -d"
alias dcd="docker compose down"

# Path shortcuts
ws() {
  builtin cd -- "$HOME"/{{ .workspaceDir | quote }}
}
alias c="claude"
{{- $profiles := (index . "profiles") | default dict }}
{{- if $profiles }}
alias dotfiles='profile-use vscode Default "$(dirname "$(chezmoi source-path)")"'
{{- with (index . "defaultProfile") }}
{{- $defaultProfile := . }}
{{- if eq $defaultProfile "Default" }}
alias code='profile-use vscode Default'
{{- else }}
{{- $config := index $profiles $defaultProfile }}
{{- if not $config }}{{ fail (printf "default profile %q is not configured" $defaultProfile) }}{{ end }}
{{- $tools := $config }}
{{- if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{- if not (has "vscode" $tools) }}{{ fail (printf "default profile %q must enable vscode" $defaultProfile) }}{{ end }}
alias code='profile-use vscode {{ $defaultProfile }}'
{{- end }}
{{- end }}
{{- range $profile, $config := $profiles -}}
{{ $tools := $config }}
{{ if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{ range $tool := $tools -}}
{{ if eq $tool "vscode" -}}
alias code-{{ $profile }}='profile-use vscode {{ $profile }}'
alias dotfiles-{{ $profile }}='profile-use vscode {{ $profile }} "$(dirname "$(chezmoi source-path)")"'
{{ else if eq $tool "antigravity" -}}
{{ else if eq $tool "gh" -}}
alias gh-{{ $profile }}='profile-use gh {{ $profile }}'
alias git-{{ $profile }}='profile-use git {{ $profile }}'
{{ else -}}
alias {{ $tool }}-{{ $profile }}='profile-use {{ $tool }} {{ $profile }}'
{{ end -}}
{{ end -}}
{{ end -}}
{{- end }}

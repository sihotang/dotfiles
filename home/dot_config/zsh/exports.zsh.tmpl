#!/usr/bin/env zsh

# Keep PATH entries unique and put user-installed tools ahead of system tools.
typeset -U path PATH

# Add optional tool paths only when installed on this machine.
[[ -d "$HOME/.orbstack/bin" ]] && path=("$HOME/.orbstack/bin" $path)
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "$HOME/.lmstudio/bin" ]] && path=("$HOME/.lmstudio/bin" $path)

# Application settings
# Keep a configured Ollama host and port; set a default only when Ollama exists.
if [[ -n ${OLLAMA_HOST:-} ]]; then
  export OLLAMA_HOST
elif (( $+commands[ollama] )); then
  export OLLAMA_HOST={{ .ollamaHost | quote }}
fi

{{ template "shell/editor.tmpl" . -}}

#!/usr/bin/env zsh

[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :

# Tool integrations (guarded so shell startup remains usable)
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

{{- $profiles := (index . "profiles") | default dict }}
{{- if $profiles }}
{{- $profilesDir := (index . "profilesDir") | default ".config/profiles" }}
{{- range $profile, $config := $profiles -}}
{{ if not (regexMatch "^[a-zA-Z0-9._-]+$" $profile) }}{{ fail (printf "invalid profile name %q" $profile) }}{{ end }}
{{ $tools := $config }}
{{ if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{ range $tool := $tools -}}
{{ if not (or (eq $tool "codex") (eq $tool "claude") (eq $tool "copilot") (eq $tool "gemini") (eq $tool "gh") (eq $tool "vscode") (eq $tool "antigravity")) }}{{ fail (printf "unsupported profile tool %q in profile %q" $tool $profile) }}{{ end }}
{{ end -}}
{{ end -}}

ai-profile-enabled() {
  case "$1:$2" in
{{ range $profile, $config := $profiles -}}
{{ $tools := $config }}
{{ if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{ range $tool := $tools -}}
    "{{ $tool }}:{{ $profile }}") return 0 ;;
{{ end -}}
{{ end -}}
    *) return 1 ;;
  esac
}

# profile-use TOOL PROFILE [arguments...] starts a CLI with an isolated state directory.
profile-use() {
  if (( $# < 2 )); then
    print -u2 'Usage: profile-use TOOL PROFILE [arguments...]'
    return 2
  fi
  local tool="$1" profile="$2" profile_dir env_name cli gh_profile_enabled=0 git_helper_prefix
  local -a profile_env
  case "$tool" in
    codex) env_name=CODEX_HOME; cli=codex ;;
    claude) env_name=CLAUDE_CONFIG_DIR; cli=claude ;;
    copilot) env_name=COPILOT_HOME; cli=copilot ;;
    gemini) env_name=GEMINI_CLI_HOME; cli=gemini ;;
    gh) env_name=GH_CONFIG_DIR; cli=gh ;;
    git) env_name=GH_CONFIG_DIR; cli=git ;;
    vscode) cli=code ;;
    *) print -u2 'profile-use: TOOL must be codex, claude, copilot, gemini, gh, git, or vscode'; return 2 ;;
  esac
  if [[ ! "$profile" =~ '^[a-zA-Z0-9._-]+$' || "$profile" == '.' || "$profile" == '..' ]]; then
    print -u2 'profile-use: profile name may contain only letters, numbers, dot, underscore, and hyphen'
    return 2
  fi
  local profile_tool="$tool"
  [[ "$tool" == git ]] && profile_tool=gh
  if ! ai-profile-enabled "$profile_tool" "$profile"; then
    if [[ "$tool" != vscode || "$profile" != Default ]]; then
      print -u2 "profile-use: profile is not configured for $tool: $profile"
      return 1
    fi
  fi
  shift 2
  if [[ "$tool" == vscode ]]; then
    profile_env=()
    local vscode_profile="$profile"
    case "$profile" in
{{ range $profile, $config := $profiles }}
{{ if not (kindIs "slice" $config) }}{{ with index $config "displayName" }}      "{{ $profile }}") vscode_profile={{ . | quote }} ;;
{{ end }}{{ end }}
{{ end }}
    esac
    case "$profile" in
{{ range $profile, $config := $profiles -}}
{{ $tools := $config }}
{{ if not (kindIs "slice" $config) }}{{ $tools = index $config "tools" }}{{ end }}
{{ if has "vscode" $tools -}}
      "{{ $profile }}")
{{ $vscodeProfile := $profile }}
{{ if not (kindIs "slice" $config) }}{{ with index $config "displayName" }}{{ $vscodeProfile = . }}{{ end }}{{ end }}
{{ range $tool := $tools -}}
{{ if eq $tool "codex" }}{{ if ne $vscodeProfile "Default" }}        profile_env+=("CODEX_HOME=$HOME/{{ $profilesDir }}/{{ $profile }}/codex")
{{ end }}
{{ else if eq $tool "claude" }}        profile_env+=("CLAUDE_CONFIG_DIR=$HOME/{{ $profilesDir }}/{{ $profile }}/claude")
{{ else if eq $tool "copilot" }}        profile_env+=("COPILOT_HOME=$HOME/{{ $profilesDir }}/{{ $profile }}/copilot")
{{ else if eq $tool "gemini" }}        profile_env+=("GEMINI_CLI_HOME=$HOME/{{ $profilesDir }}/{{ $profile }}/gemini")
{{ else if eq $tool "gh" }}        gh_profile_enabled=1
        profile_env+=("GH_CONFIG_DIR=$HOME/{{ $profilesDir }}/{{ $profile }}/gh")
        git_helper_prefix=$(printf '\041')
        profile_env+=("GIT_CONFIG_COUNT=2" "GIT_CONFIG_KEY_0=credential.helper" "GIT_CONFIG_VALUE_0=" "GIT_CONFIG_KEY_1=credential.helper" "GIT_CONFIG_VALUE_1=${git_helper_prefix}gh auth git-credential")
{{ end -}}
{{ end -}}
        ;;
{{ end -}}
{{ end -}}
      *) ;;
    esac
    # VS Code inherits the first running instance's environment; quit it before switching profiles.
    if (( gh_profile_enabled )); then
      (
        unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
        if [[ "$vscode_profile" == "Default" ]]; then
          unset CODEX_HOME
        fi
        command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
      )
      return $?
    fi
    if [[ "$vscode_profile" == "Default" ]]; then
      (
        unset CODEX_HOME
        command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
      )
      return $?
    fi
    command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
    return $?
  fi
  profile_dir="$HOME/{{ $profilesDir }}/$profile/$profile_tool"
  if [[ ! -d "$profile_dir" ]]; then
    print -u2 "profile-use: profile not found: $tool/$profile"
    return 1
  fi
  if [[ "$tool" == gh ]]; then
    (
      unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
      export GH_CONFIG_DIR="$profile_dir"
      command gh "$@"
    )
    return $?
  fi
  if [[ "$tool" == git ]]; then
    git_helper_prefix=$(printf '\041')
    (
      unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
      export GH_CONFIG_DIR="$profile_dir"
      export GIT_CONFIG_COUNT=2
      export GIT_CONFIG_KEY_0=credential.helper
      export GIT_CONFIG_VALUE_0=
      export GIT_CONFIG_KEY_1=credential.helper
      export GIT_CONFIG_VALUE_1="${git_helper_prefix}gh auth git-credential"
      command git "$@"
    )
    return $?
  fi
  command env "$env_name=$profile_dir" "$cli" "$@"
}

# Keep the previous assistant-focused command available for existing shell usage.
ai-use() {
  profile-use "$@"
}

{{- end }}

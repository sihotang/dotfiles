#!/usr/bin/env zsh

# mkcd DIRECTORY
# Create the directory and any missing parent directories, then enter it.
# Requires exactly one argument.
mkcd() {
  if (( $# != 1 )); then
    print -u2 'Usage: mkcd DIRECTORY'
    return 2
  fi

  command mkdir -p -- "$1" && builtin cd -- "$1"
}

# up [COUNT]
# Move up one or more directory levels. Defaults to one level; for example,
# `up 3` moves up three levels. The count must be a positive integer.
up() {
  local levels="${1:-1}"
  if (( $# > 1 )) || ! [[ "$levels" =~ '^[0-9]+$' ]] || (( levels < 1 )); then
    print -u2 'Usage: up [POSITIVE_NUMBER]'
    return 2
  fi

  local destination=''
  local i
  for (( i = 1; i <= levels; i++ )); do
    destination+='../'
  done
  builtin cd -- "$destination"
}

# croot
# Change to the root of the current Git repository, even when called from a
# subdirectory. Returns an error when called outside a Git repository.
croot() {
  if (( $# != 0 )); then
    print -u2 'Usage: croot'
    return 2
  fi

  local root
  root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'croot: not inside a Git repository'
    return 1
  }
  builtin cd -- "$root"
}

# extract ARCHIVE
# Extract one archive into the current working directory. Supports tar files
# (including .tar.gz/.tgz, .tar.bz2/.tbz2, .tar.xz/.txz, and .tar.zst/.tzst),
# zip, gzip, bzip2, and xz. Extraction follows each system utility's default
# behavior; check for filename conflicts before running it.
extract() {
  if (( $# != 1 )); then
    print -u2 'Usage: extract ARCHIVE'
    return 2
  fi

  local archive="$1"
  if [[ ! -f "$archive" ]]; then
    print -u2 "extract: file not found: $archive"
    return 1
  fi

  case "$archive" in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst)
      command tar -xf "$archive"
      ;;
    *.zip)
      command unzip "$archive"
      ;;
    *.gz)
      command gunzip "$archive"
      ;;
    *.bz2)
      command bunzip2 "$archive"
      ;;
    *.xz)
      command unxz "$archive"
      ;;
    *)
      print -u2 "extract: unsupported archive format: $archive"
      return 2
      ;;
  esac
}

{{- $profiles := (index . "profiles") | default dict }}
{{- $profilesDir := (index . "profilesDir") | default ".config/profiles" }}
{{- if and (kindIs "map" $profiles) (gt (len $profiles) 0) }}
  {{- range $profile, $config := $profiles }}
    {{- if not (regexMatch "^[a-zA-Z0-9._-]+$" $profile) }}
      {{- fail (printf "invalid profile name %q" $profile) }}
    {{- end }}

    {{- $tools := $config }}
    {{- if not (kindIs "slice" $config) }}
      {{- $tools = index $config "tools" }}
    {{- end }}
    {{- range $tool := $tools }}
      {{- if not (or
        (eq $tool "codex")
        (eq $tool "claude")
        (eq $tool "copilot")
        (eq $tool "gemini")
        (eq $tool "gh")
        (eq $tool "git")
        (eq $tool "vscode")
        (eq $tool "antigravity")
      ) }}
        {{- fail (printf "unsupported profile tool %q in profile %q" $tool $profile) }}
      {{- end }}
    {{- end }}

    {{- if not (kindIs "slice" $config) }}
      {{- $gitConfig := index $config "git" | default dict }}
      {{- if not (kindIs "map" $gitConfig) }}
        {{- fail (printf "git config for profile %q must be a table" $profile) }}
      {{- end }}

      {{- if has "gh" $tools }}
        {{- $ghConfig := index $config "gh" | default dict }}
        {{- if not (kindIs "map" $ghConfig) }}
          {{- fail (printf "gh config for profile %q must be a table" $profile) }}
        {{- end }}
        {{- $ghUsername := index $ghConfig "username" | default $profile }}
        {{- if not (regexMatch "^[a-zA-Z0-9-]+$" $ghUsername) }}
          {{- fail (printf "invalid GitHub username %q for profile %q" $ghUsername $profile) }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

# Return success when PROFILE includes TOOL in its configured tool list.
profile-enabled() {
  case "$1:$2" in{{ "\n" -}}
    {{- range $profile, $config := $profiles -}}
      {{- $tools := $config -}}
      {{- if not (kindIs "slice" $config) -}}
        {{- $tools = index $config "tools" -}}
      {{- end -}}
      {{- range $tool := $tools -}}
        {{- printf "    \"%s:%s\") return 0 ;;\n" $tool $profile -}}
      {{- end -}}
    {{- end -}}
    *) return 1 ;;
  esac
}

# Set the GitHub credential helper and optional profile-specific author identity.
profile-git-config() {
  local profile="$1" gh_enabled="${2:-1}" git_config_parameters=''
  if [[ "$gh_enabled" == 1 ]]; then
    git_config_parameters="'credential.helper=' 'credential.helper=!gh auth git-credential'"
  fi
  unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1
  case "$profile" in{{ "\n" -}}
    {{- range $profile, $config := $profiles -}}
      {{- $profileData := dict -}}
      {{- $tools := $config -}}
      {{- $gitConfig := dict -}}
      {{- if not (kindIs "slice" $config) -}}
        {{- $profileData = $config -}}
        {{- $tools = index $config "tools" -}}
        {{- $gitConfig = index $config "git" | default dict -}}
      {{- end -}}
      {{- $gitName := printf "%v" (index $gitConfig "name" | default (index $profileData "name" | default "")) -}}
      {{- $gitEmail := printf "%v" (index $gitConfig "email" | default (index $profileData "email" | default "")) -}}
      {{- if and (has "git" $tools) (or $gitName $gitEmail) -}}
        {{- printf "    \"%s\")\n" $profile -}}
        {{- if $gitName -}}
          {{- printf "      git_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'user.name=%s'\"\n" (replace "'" "'\\''" $gitName) -}}
        {{- end -}}
        {{- if $gitEmail -}}
          {{- printf "      git_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'user.email=%s'\"\n" (replace "'" "'\\''" $gitEmail) -}}
        {{- end -}}
        {{- printf "      ;;\n" -}}
      {{- end -}}
    {{- end -}}
    *) ;;
  esac
  if [[ -n "$git_config_parameters" ]]; then
    export GIT_CONFIG_PARAMETERS="$git_config_parameters"
  else
    unset GIT_CONFIG_PARAMETERS
  fi
}

# Clear profile-specific paths before launching a default or unprofiled application.
profile-clear-environment() {
  unset CODEX_HOME CLAUDE_CONFIG_DIR COPILOT_HOME GEMINI_CLI_HOME GH_CONFIG_DIR
}

# Remove inherited GitHub tokens so gh uses the selected profile's credentials.
profile-clear-gh-environment() {
  unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
}

# Switch the shared GitHub CLI configuration to the profile's stored account.
profile-gh-switch() {
  local profile="$1" username=''
  case "$profile" in{{ "\n" -}}
    {{- range $profile, $config := $profiles -}}
      {{- $tools := $config -}}
      {{- if not (kindIs "slice" $config) -}}
        {{- $tools = index $config "tools" -}}
      {{- end -}}
      {{- if has "gh" $tools -}}
        {{- $username := $profile -}}
        {{- if kindIs "map" $config -}}
          {{- $ghConfig := index $config "gh" | default dict -}}
          {{- $username = index $ghConfig "username" | default $profile -}}
        {{- end -}}
        {{- printf "    %s) username=%s ;;\n" $profile ($username | quote) -}}
      {{- end -}}
    {{- end -}}
    *) print -u2 "profile-use: GitHub account is not configured: $profile"; return 1 ;;
  esac
  profile-clear-gh-environment
  unset GH_CONFIG_DIR
  unset GIT_CONFIG_PARAMETERS
  command gh auth switch --hostname github.com --user "$username"
}

# Start VS Code with its profile-specific environment.
profile-use-vscode() {
  local profile="$1" gh_profile_enabled=0 git_profile_enabled=0
  local vscode_profile="$profile"
  local -a profile_env=()
  shift

  case "$profile" in{{ "\n" -}}
    {{- range $profile, $config := $profiles -}}
      {{- if not (kindIs "slice" $config) -}}
        {{- with index $config "displayName" -}}
          {{- printf "    \"%s\") vscode_profile=%s ;;\n" $profile (. | quote) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- printf "  esac\n" }}
  case "$profile" in{{ "\n" -}}
    {{- range $profile, $config := $profiles -}}
      {{- $tools := $config -}}
      {{- if not (kindIs "slice" $config) -}}
        {{- $tools = index $config "tools" -}}
      {{- end -}}
      {{- if has "vscode" $tools -}}
        {{- printf "    \"%s\")\n" $profile -}}
        {{- range $tool := $tools -}}
          {{- if eq $tool "codex" -}}
            {{- printf "      profile_env+=(\"CODEX_HOME=$HOME/%s/%s/codex\")\n" $profilesDir $profile -}}
          {{- else if eq $tool "claude" -}}
            {{- printf "      profile_env+=(\"CLAUDE_CONFIG_DIR=$HOME/%s/%s/claude\")\n" $profilesDir $profile -}}
          {{- else if eq $tool "copilot" -}}
            {{- printf "      profile_env+=(\"COPILOT_HOME=$HOME/%s/%s/copilot\")\n" $profilesDir $profile -}}
          {{- else if eq $tool "gemini" -}}
            {{- printf "      profile_env+=(\"GEMINI_CLI_HOME=$HOME/%s/%s/gemini\")\n" $profilesDir $profile -}}
          {{- else if eq $tool "gh" -}}
            {{- printf "      gh_profile_enabled=1\n" -}}
          {{- else if eq $tool "git" -}}
            {{- printf "      git_profile_enabled=1\n" -}}
          {{- end -}}
        {{- end -}}
        {{- printf "      ;;\n" -}}
      {{- end -}}
    {{- end -}}
    {{- printf "    *) ;;\n  esac\n" }}

  # VS Code inherits the first running instance's environment; quit it before switching profiles.
  if (( gh_profile_enabled || git_profile_enabled )); then
    (
      if (( gh_profile_enabled )); then
        profile-gh-switch "$profile" || return $?
      fi
      profile-git-config "$profile" "$git_profile_enabled"
      if [[ "$vscode_profile" == "Default" ]]; then
        profile-clear-environment
      fi
      command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
    )
  elif [[ "$vscode_profile" == "Default" ]]; then
    (
      profile-clear-environment
      command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
    )
  else
    command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
  fi
}

# Run Git with the selected profile's GitHub credentials and author identity.
profile-use-git() {
  local profile="$1"
  shift
  (
    if profile-enabled gh "$profile"; then
      profile-gh-switch "$profile" || return $?
    fi
    profile-git-config "$profile"
    command git "$@"
  )
}

# Start a supported CLI with its profile-specific state directory.
profile-use-cli() {
  local tool="$1" profile="$2" profile_dir env_name cli
  shift 2

  if [[ "$tool" == gh ]]; then
    (
      profile-gh-switch "$profile" || return $?
      profile-git-config "$profile" 0
      command gh "$@"
    )
    return $?
  fi

  profile_dir="$HOME/{{ $profilesDir }}/$profile/$tool"
  if [[ ! -d "$profile_dir" ]]; then
    print -u2 "profile-use: profile not found: $tool/$profile"
    return 1
  fi

  case "$tool" in
    codex) env_name=CODEX_HOME; cli=codex ;;
    claude) env_name=CLAUDE_CONFIG_DIR; cli=claude ;;
    copilot) env_name=COPILOT_HOME; cli=copilot ;;
    gemini) env_name=GEMINI_CLI_HOME; cli=gemini ;;
  esac

  command env "$env_name=$profile_dir" "$cli" "$@"
}

# profile-use TOOL PROFILE [arguments...] starts a CLI with an isolated state directory.
profile-use() {
  if (( $# < 2 )); then
    print -u2 'Usage: profile-use TOOL PROFILE [arguments...]'
    return 2
  fi
  local tool="$1" profile="$2"
  case "$tool" in
    codex|claude|copilot|gemini|gh|git|vscode) ;;
    *) print -u2 'profile-use: TOOL must be codex, claude, copilot, gemini, gh, git, or vscode'; return 2 ;;
  esac
  if [[ ! "$profile" =~ '^[a-zA-Z0-9._-]+$' || "$profile" == '.' || "$profile" == '..' ]]; then
    print -u2 'profile-use: profile name may contain only letters, numbers, dot, underscore, and hyphen'
    return 2
  fi
  if ! profile-enabled "$tool" "$profile"; then
    if [[ "$tool" != vscode || "$profile" != Default ]]; then
      print -u2 "profile-use: profile is not configured for $tool: $profile"
      return 1
    fi
  fi
  shift 2
  case "$tool" in
    vscode) profile-use-vscode "$profile" "$@" ;;
    git) profile-use-git "$profile" "$@" ;;
    *) profile-use-cli "$tool" "$profile" "$@" ;;
  esac
}

{{- end }}

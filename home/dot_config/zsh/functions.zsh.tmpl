#!/usr/bin/env zsh

# mkcd DIRECTORY
# Create the directory and any missing parent directories, then enter it.
# Requires exactly one argument.
mkcd() {
  if (( $# != 1 )); then
    print -u2 'Usage: mkcd DIRECTORY'
    return 2
  fi

  command mkdir -p -- "$1" && builtin cd -- "$1"
}

# up [COUNT]
# Move up one or more directory levels. Defaults to one level; for example,
# `up 3` moves up three levels. The count must be a positive integer.
up() {
  local levels="${1:-1}"
  if (( $# > 1 )) || ! [[ "$levels" =~ '^[0-9]+$' ]] || (( levels < 1 )); then
    print -u2 'Usage: up [POSITIVE_NUMBER]'
    return 2
  fi

  local destination=''
  local i
  for (( i = 1; i <= levels; i++ )); do
    destination+='../'
  done
  builtin cd -- "$destination"
}

# croot
# Change to the root of the current Git repository, even when called from a
# subdirectory. Returns an error when called outside a Git repository.
croot() {
  if (( $# != 0 )); then
    print -u2 'Usage: croot'
    return 2
  fi

  local root
  root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'croot: not inside a Git repository'
    return 1
  }
  builtin cd -- "$root"
}

# extract ARCHIVE
# Extract one archive into the current working directory. Supports tar files
# (including .tar.gz/.tgz, .tar.bz2/.tbz2, .tar.xz/.txz, and .tar.zst/.tzst),
# zip, gzip, bzip2, and xz. Extraction follows each system utility's default
# behavior; check for filename conflicts before running it.
extract() {
  if (( $# != 1 )); then
    print -u2 'Usage: extract ARCHIVE'
    return 2
  fi

  local archive="$1"
  if [[ ! -f "$archive" ]]; then
    print -u2 "extract: file not found: $archive"
    return 1
  fi

  case "$archive" in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst)
      command tar -xf "$archive"
      ;;
    *.zip)
      command unzip "$archive"
      ;;
    *.gz)
      command gunzip "$archive"
      ;;
    *.bz2)
      command bunzip2 "$archive"
      ;;
    *.xz)
      command unxz "$archive"
      ;;
    *)
      print -u2 "extract: unsupported archive format: $archive"
      return 2
      ;;
  esac
}

{{- $profiles := (index . "profiles") | default dict }}
{{- if $profiles }}
{{- $profilesDir := (index . "profilesDir") | default ".config/profiles" }}
{{- range $profile, $config := $profiles -}}
{{- if not (regexMatch "^[a-zA-Z0-9._-]+$" $profile) -}}{{ fail (printf "invalid profile name %q" $profile) }}{{- end -}}
{{- $tools := $config -}}
{{- if not (kindIs "slice" $config) -}}{{ $tools = index $config "tools" }}{{- end -}}
{{- range $tool := $tools -}}
{{- if not (or (eq $tool "codex") (eq $tool "claude") (eq $tool "copilot") (eq $tool "gemini") (eq $tool "gh") (eq $tool "git") (eq $tool "vscode") (eq $tool "antigravity")) -}}{{ fail (printf "unsupported profile tool %q in profile %q" $tool $profile) }}{{- end -}}
{{- end -}}
{{- if not (kindIs "slice" $config) -}}
{{- $gitConfig := index $config "git" | default dict -}}
{{- if not (kindIs "map" $gitConfig) -}}{{ fail (printf "git config for profile %q must be a table" $profile) }}{{- end -}}
{{- $gitName := index $gitConfig "name" | default (index $config "name" | default "") -}}
{{- $gitEmail := index $gitConfig "email" | default (index $config "email" | default "") -}}
{{- end -}}
{{- end }}

profile-enabled() {
  case "$1:$2" in{{ "\n" -}}
{{- range $profile, $config := $profiles -}}
{{- $tools := $config -}}
{{- if not (kindIs "slice" $config) -}}{{ $tools = index $config "tools" }}{{- end -}}
{{- range $tool := $tools -}}
{{ printf "    \"%s:%s\") return 0 ;;\n" $tool $profile }}
{{- end -}}
{{- end -}}
    *) return 1 ;;
  esac
}

# Set the GitHub credential helper and optional profile-specific author identity.
profile-git-config() {
  local profile="$1" git_helper_prefix
  git_helper_prefix=$(printf '\041')
  export GIT_CONFIG_KEY_0=credential.helper
  export GIT_CONFIG_VALUE_0=
  export GIT_CONFIG_KEY_1=credential.helper
  export GIT_CONFIG_VALUE_1="${git_helper_prefix}gh auth git-credential"
  export GIT_CONFIG_COUNT=2
  case "$profile" in{{ "\n" -}}
{{- range $profile, $config := $profiles -}}
{{- $gitConfig := dict -}}
{{- if not (kindIs "slice" $config) -}}{{ $gitConfig = index $config "git" | default dict }}{{- end -}}
{{- $gitName := index $gitConfig "name" | default (index $config "name" | default "") -}}
{{- $gitEmail := index $gitConfig "email" | default (index $config "email" | default "") -}}
{{- $tools := index $config "tools" -}}
{{- if and (has "git" $tools) (or $gitName $gitEmail) -}}
{{ printf "    \"%s\")\n" $profile -}}
{{- if $gitName -}}
{{ printf "      export GIT_CONFIG_KEY_2=user.name\n" -}}
{{ printf "      export GIT_CONFIG_VALUE_2=%s\n" (printf "'%s'" (replace "'" "'\\''" $gitName)) -}}
{{ printf "      export GIT_CONFIG_COUNT=$(( GIT_CONFIG_COUNT + 1 ))\n" -}}
{{- end -}}
{{- if $gitEmail -}}
{{- if $gitName -}}
{{ printf "      export GIT_CONFIG_KEY_3=user.email\n" -}}
{{ printf "      export GIT_CONFIG_VALUE_3=%s\n" (printf "'%s'" (replace "'" "'\\''" $gitEmail)) -}}
{{- else -}}
{{ printf "      export GIT_CONFIG_KEY_2=user.email\n" -}}
{{ printf "      export GIT_CONFIG_VALUE_2=%s\n" (printf "'%s'" (replace "'" "'\\''" $gitEmail)) -}}
{{- end -}}
{{ printf "      export GIT_CONFIG_COUNT=$(( GIT_CONFIG_COUNT + 1 ))\n" -}}
{{- end -}}
{{ printf "      ;;\n" -}}
{{- end -}}
{{- end -}}
    *) export GIT_CONFIG_COUNT=2 ;;
  esac
}

# profile-use TOOL PROFILE [arguments...] starts a CLI with an isolated state directory.
profile-use() {
  if (( $# < 2 )); then
    print -u2 'Usage: profile-use TOOL PROFILE [arguments...]'
    return 2
  fi
  local tool="$1" profile="$2" profile_dir env_name cli gh_profile_enabled=0
  local -a profile_env
  case "$tool" in
    codex) env_name=CODEX_HOME; cli=codex ;;
    claude) env_name=CLAUDE_CONFIG_DIR; cli=claude ;;
    copilot) env_name=COPILOT_HOME; cli=copilot ;;
    gemini) env_name=GEMINI_CLI_HOME; cli=gemini ;;
    gh) env_name=GH_CONFIG_DIR; cli=gh ;;
    git) env_name=GH_CONFIG_DIR; cli=git ;;
    vscode) cli=code ;;
    *) print -u2 'profile-use: TOOL must be codex, claude, copilot, gemini, gh, git, or vscode'; return 2 ;;
  esac
  if [[ ! "$profile" =~ '^[a-zA-Z0-9._-]+$' || "$profile" == '.' || "$profile" == '..' ]]; then
    print -u2 'profile-use: profile name may contain only letters, numbers, dot, underscore, and hyphen'
    return 2
  fi
  local profile_tool="$tool"
  [[ "$tool" == git ]] && profile_tool=git
  if ! profile-enabled "$profile_tool" "$profile"; then
    if [[ "$tool" != vscode || "$profile" != Default ]]; then
      print -u2 "profile-use: profile is not configured for $tool: $profile"
      return 1
    fi
  fi
  shift 2
  if [[ "$tool" == vscode ]]; then
    profile_env=()
    local vscode_profile="$profile"
    case "$profile" in{{ "\n" -}}
{{- range $profile, $config := $profiles -}}
{{- if not (kindIs "slice" $config) -}}
{{- with index $config "displayName" -}}
{{ printf "      \"%s\") vscode_profile=%s ;;\n" $profile (. | quote) }}
{{- end -}}
{{- end -}}
{{- end -}}
    esac
    case "$profile" in{{ "\n" -}}
{{- range $profile, $config := $profiles -}}
{{- $tools := $config -}}
{{- if not (kindIs "slice" $config) -}}{{ $tools = index $config "tools" }}{{- end -}}
{{- if has "vscode" $tools -}}
{{ printf "      \"%s\")\n" $profile -}}
{{- $vscodeProfile := $profile -}}
{{- if not (kindIs "slice" $config) -}}
{{- with index $config "displayName" -}}
{{- $vscodeProfile = . -}}
{{- end -}}
{{- end -}}
{{- range $tool := $tools -}}
{{- if eq $tool "codex" -}}
{{- if ne $vscodeProfile "Default" -}}
{{ printf "        profile_env+=(\"CODEX_HOME=$HOME/%s/%s/codex\")\n" $profilesDir $profile -}}
{{- end -}}
{{- else if eq $tool "claude" -}}
{{ printf "        profile_env+=(\"CLAUDE_CONFIG_DIR=$HOME/%s/%s/claude\")\n" $profilesDir $profile -}}
{{- else if eq $tool "copilot" -}}
{{ printf "        profile_env+=(\"COPILOT_HOME=$HOME/%s/%s/copilot\")\n" $profilesDir $profile -}}
{{- else if eq $tool "gemini" -}}
{{ printf "        profile_env+=(\"GEMINI_CLI_HOME=$HOME/%s/%s/gemini\")\n" $profilesDir $profile -}}
{{- else if eq $tool "gh" -}}
{{ printf "        gh_profile_enabled=1\n" -}}
{{ printf "        profile_env+=(\"GH_CONFIG_DIR=$HOME/%s/%s/gh\")\n" $profilesDir $profile -}}
{{- end -}}
{{- end -}}
{{ printf "        ;;\n" -}}
{{- end -}}
{{- end -}}
      *) ;;
    esac
    # VS Code inherits the first running instance's environment; quit it before switching profiles.
    if (( gh_profile_enabled )); then
      (
        unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
        profile-git-config "$profile"
        if [[ "$vscode_profile" == "Default" ]]; then
          unset CODEX_HOME
        fi
        command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
      )
      return $?
    fi
    if [[ "$vscode_profile" == "Default" ]]; then
      (
        unset CODEX_HOME
        command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
      )
      return $?
    fi
    command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
    return $?
  fi
  if [[ "$tool" == git ]]; then
    (
      if profile-enabled gh "$profile"; then
        unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
        export GH_CONFIG_DIR="$HOME/{{ $profilesDir }}/$profile/gh"
      fi
      profile-git-config "$profile"
      command git "$@"
    )
    return $?
  fi
  profile_dir="$HOME/{{ $profilesDir }}/$profile/$profile_tool"
  if [[ ! -d "$profile_dir" ]]; then
    print -u2 "profile-use: profile not found: $tool/$profile"
    return 1
  fi
  if [[ "$tool" == gh ]]; then
    (
      unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
      export GH_CONFIG_DIR="$profile_dir"
      command gh "$@"
    )
    return $?
  fi
  command env "$env_name=$profile_dir" "$cli" "$@"
}

{{- end }}

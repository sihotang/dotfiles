# Copy this file to home/.chezmoidata/profile.yaml and adjust as needed.
# Profile-specific settings live under the `profiles` mapping.
name: Your Name
email: you@example.com
profiles:
  personal:
    name: Your Personal Name
    email: you@example.com
    alias: personal
    tools:
      - antigravity
      - claude
      - codex
      - copilot
      - gemini
      - gh
      - git
      - vscode
    ai:
      force: false
      instructions: |
        For personal projects, explore alternatives before choosing an implementation.
    codex:
      force: false
      instructions: |
        Keep the personal-project instructions concise and explain meaningful tradeoffs.
    git:
      name: Your Git Name
      email: another@example.com
    gh:
      username: your-personal-github-username

  work:
    name: Your Work Name
    email: you@company.example
    alias: work
    tools:
      - codex
      - gh
      - vscode
    gh:
      username: your-work-github-username
    ai:
      force: true
      instructions: |
        For work projects, prefer small changes and do not change public APIs without confirmation.
    codex:
      force: false
      instructions: |
        For Codex in this profile, follow the work-specific Codex workflow documented here.

  client:
    name: Your Client Name
    email: you@client.example
    alias: your-client-alias
    tools:
      - codex
      - gh
      - vscode
    gh:
      username: your-client-github-username

# Copy these profiles into home/.chezmoidata/profiles.toml and adjust as needed.
[profiles]
instructions = """
Use small, reviewable changes for every configured profile.
"""
additionalInstructions = """
Include validation results in summaries for every configured profile.
"""

[profiles.personal]
name = "Your Personal Name"
email = "you@example.com"
displayName = "Personal"
tools = ["vscode", "gh", "git", "codex", "claude", "copilot", "gemini", "antigravity"]
additionalInstructions = """
For personal projects, explore alternatives before choosing an implementation.
"""

[profiles.personal.git]
name = "Your Git Name"
email = "another@example.com"

[profiles.personal.codex]
additionalInstructions = """
Keep the personal-project instructions concise and explain meaningful tradeoffs.
"""

[profiles.work]
name = "Your Work Name"
email = "you@company.example"
tools = ["codex", "gh", "vscode"]
displayName = "Work"
instructions = """
For work projects, prefer small changes and do not change public APIs without confirmation.
"""

[profiles.work.codex]
instructions = """
For Codex in this profile, follow the work-specific Codex workflow documented here.
"""

[profiles.client]
tools = ["codex", "gh", "vscode"]
displayName = "Client"
